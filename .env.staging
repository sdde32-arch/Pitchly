# Staging Build Environment (Unprovisioned / Placeholder)
# This intentional placeholder guarantees fail-closed build rejection until
# the project owner provisions and supplies an approved staging project ID.
VITE_APP_ENV=staging
VITE_FIREBASE_PROJECT_ID=your-staging-project-id
VITE_FIREBASE_EXPECTED_PROJECT_ID=your-staging-project-id
VITE_FIREBASE_API_KEY=your_staging_api_key_placeholder
VITE_FIREBASE_AUTH_DOMAIN=your-staging-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-staging-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:stagingplaceholder
VITE_FIRESTORE_DATABASE_ID=(default)
VITE_USE_FIREBASE_EMULATOR=false
