# .env.example
# General application configuration
VITE_APP_ENV=development

# Firebase Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_EXPECTED_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=(default)

# Local Emulator (Development only - strictly prohibited in staging and production)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# Google Maps Platform (Client-side)
GOOGLE_MAPS_PLATFORM_KEY=

# Server-Side API Keys (DO NOT prefix with VITE_ - never exposed to browser)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
