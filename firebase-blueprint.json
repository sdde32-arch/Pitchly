{
  "entities": {
    "User": {
      "title": "User",
      "description": "Pitchly user account entity supporting players, owners, and administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["PLAYER", "OWNER", "admin", "super_admin"] },
        "roles": { "type": "array", "items": { "type": "string" } },
        "avatarId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "Pitch": {
      "title": "Pitch",
      "description": "Football facility / turf details including location, pricing, images, and amenities.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "pricePerHour": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "PENDING_APPROVAL", "DRAFT", "SUSPENDED"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["id", "name", "pricePerHour", "status"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Match booking transaction and scheduled time reservation on a pitch.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pitchId": { "type": "string" },
        "playerId": { "type": "string" },
        "ownerId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "hours": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING_PAYMENT", "PAYMENT_SUBMITTED", "CONFIRMED", "COMPLETED", "CANCELLED", "REJECTED"] }
      },
      "required": ["id", "pitchId", "playerId", "date", "time", "status"]
    },
    "SlotLock": {
      "title": "SlotLock",
      "description": "Temporary high-concurrency reservation lock preventing double bookings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pitchId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "userId": { "type": "string" },
        "expiresAt": { "type": "number" }
      },
      "required": ["pitchId", "date", "time", "userId", "expiresAt"]
    },
    "TournamentStanding": {
      "title": "TournamentStanding",
      "description": "Aggregated team standing and leaderboard record dynamically computed from match results.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tournamentId": { "type": "string" },
        "team": { "type": "string" },
        "group": { "type": "string" },
        "played": { "type": "number" },
        "won": { "type": "number" },
        "drawn": { "type": "number" },
        "lost": { "type": "number" },
        "goalsFor": { "type": "number" },
        "goalsAgainst": { "type": "number" },
        "goalDifference": { "type": "number" },
        "points": { "type": "number" },
        "winRate": { "type": "number" },
        "form": { "type": "array", "items": { "type": "string" } },
        "position": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tournamentId", "team", "points", "goalDifference", "won"]
    },
    "CommunityActivity": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["match_played", "team_formed", "tournament_completed"] },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "venue": { "type": "string" },
        "matchScore": { "type": "string" },
        "teamName": { "type": "string" },
        "tournamentName": { "type": "string" },
        "champion": { "type": "string" },
        "likesCount": { "type": "number" },
        "celebrationsCount": { "type": "number" },
        "likedBy": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" },
        "badge": { "type": "string" },
        "meta": { "type": "object" }
      },
      "required": ["id", "type", "title", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and credentials"
    },
    "/pitches/{pitchId}": {
      "schema": { "$ref": "#/entities/Pitch" },
      "description": "Turf listings and details"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Match bookings and transactions"
    },
    "/slotLocks/{lockId}": {
      "schema": { "$ref": "#/entities/SlotLock" },
      "description": "Slot concurrency locks"
    },
    "/tournamentStandings/{standingId}": {
      "schema": { "$ref": "#/entities/TournamentStanding" },
      "description": "Aggregated tournament team standings and leaderboard sorted by points, goal difference, and wins"
    },
    "/communityActivities/{activityId}": {
      "schema": { "$ref": "#/entities/CommunityActivity" },
      "description": "Feed of real-time community actions: matches played, new teams formed, and tournaments completed"
    }
  }
}
