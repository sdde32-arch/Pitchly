# .env.staging.example
# Staging Environment Configuration Template
# DO NOT COMMIT SECRETS. Fill with approved staging project credentials once provisioned.
VITE_APP_ENV=staging
VITE_FIREBASE_PROJECT_ID=[STAGING_PROJECT_ID]
VITE_FIREBASE_EXPECTED_PROJECT_ID=[STAGING_PROJECT_ID]
VITE_FIREBASE_API_KEY=[STAGING_API_KEY]
VITE_FIREBASE_AUTH_DOMAIN=[STAGING_PROJECT_ID].firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=[STAGING_PROJECT_ID].firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=[STAGING_SENDER_ID]
VITE_FIREBASE_APP_ID=[STAGING_APP_ID]
VITE_FIRESTORE_DATABASE_ID=(default)

# Emulators are strictly prohibited in staging
VITE_USE_FIREBASE_EMULATOR=false

GOOGLE_MAPS_PLATFORM_KEY=
GEMINI_API_KEY=
