rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      let isAuthenticatedUser = request.auth != null;
      let uid = isAuthenticatedUser ? request.auth.uid : 'none';
      let userDoc = isAuthenticatedUser && exists(/databases/$(database)/documents/users/$(uid)) ? get(/databases/$(database)/documents/users/$(uid)) : null;
      return isAuthenticatedUser && (
        uid == '0uVlAOWTy7dpqAW5tsgxQVs4PW43' ||
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'super_admin' || 
        request.auth.token.role == 'ADMIN' ||
        (userDoc != null && (
          userDoc.data.get('role', '') == 'admin' ||
          userDoc.data.get('role', '') == 'ADMIN' ||
          userDoc.data.get('role', '') == 'super_admin'
        ))
      );
    }

    function isSuperAdmin() {
      let isAuthenticatedUser = request.auth != null;
      let uid = isAuthenticatedUser ? request.auth.uid : 'none';
      let userDoc = isAuthenticatedUser && exists(/databases/$(database)/documents/users/$(uid)) ? get(/databases/$(database)/documents/users/$(uid)) : null;
      return isAuthenticatedUser && (
        request.auth.token.role == 'super_admin' || 
        (userDoc != null && userDoc.data.get('role', '') == 'super_admin')
      );
    }

    function isBookingParticipant(bId) {
      let bPath = /databases/$(database)/documents/bookings/$(bId);
      return exists(bPath) && (
        get(bPath).data.playerId == request.auth.uid || 
        get(bPath).data.userId == request.auth.uid || 
        get(bPath).data.ownerId == request.auth.uid
      );
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && userId == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role in ['PLAYER', 'OWNER']);
      // Users can't escalate privileges (but can update role to staff from accepted invite or switch between their authorized roles)
      allow update, delete: if (
        isOwner(userId) && 
        request.resource.data.get('roles', resource.data.roles) == resource.data.roles &&
        (
          request.resource.data.get('role', resource.data.role) == resource.data.role || 
          request.resource.data.get('role', resource.data.role) in ['staff', 'STAFF'] ||
          (request.resource.data.get('role', resource.data.role) in ['PLAYER', 'OWNER'] && request.resource.data.get('role', resource.data.role) in resource.data.roles)
        )
      ) || isAdmin();
    }

    // PITCHES
    match /pitches/{pitchId} {
      // Helper to validate geographic location details are present and typed correctly
      function isValidPitchLocation(data) {
        return data.keys().hasAll(['latitude', 'longitude', 'formattedAddress'])
          && data.latitude is number
          && data.longitude is number
          && data.formattedAddress is string;
      }

      // Public can read only approved/active pitches. Authenticated users can also read these.
      allow read: if resource == null || resource.data.status == 'ACTIVE';
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      // Authenticated owners can create pitches with PENDING_APPROVAL status
      allow create: if isAuthenticated() 
        && request.resource.data.status == 'PENDING_APPROVAL'
        && request.resource.data.ownerId == request.auth.uid
        && isValidPitchLocation(request.resource.data);
      
      // Owners can update their own pitches. Admins can update.
      allow update: if isAuthenticated() && (
        (
          resource.data.ownerId == request.auth.uid && 
          (
            // If it was already ACTIVE, they can keep it ACTIVE or demote it for re-review
            (resource.data.status == 'ACTIVE' && request.resource.data.status in ['ACTIVE', 'PENDING_APPROVAL']) ||
            // If it wasn't ACTIVE, they cannot self-approve it
            (resource.data.status != 'ACTIVE' && request.resource.data.status != 'ACTIVE')
          )
          && isValidPitchLocation(request.resource.data)
        ) ||
        isAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
    }

    // SLOT LOCKS
    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // SLOT AVAILABILITY (Public lightweight slot status mirror: only pitchId, date, time, status)
    match /slotAvailability/{slotId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // STAFF
    match /staff/{staffId} {
      // NOTE: Client-side timestamp comparison is currently used for invite expiry. 
      // In production, a Cloud Function should be implemented to securely invalidate 
      // or clean up expired staff invites and prevent acceptance of expired invites 
      // by validating inviteExpiresAt against request.time.
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        resource.data.status == 'PENDING' ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        (
          resource.data.status == 'PENDING' && 
          request.resource.data.userId == request.auth.uid && 
          request.resource.data.status == 'ACTIVE'
        ) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // BOOKINGS
    match /bookings/{bookingId} {
      // Allow read only for participant player, pitch owner, or admin
      allow read: if isAuthenticated() && (
        resource.data.playerId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        isAdmin()
      );
      
      allow create: if isAuthenticated() && 
        (request.resource.data.playerId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        (request.resource.data.status in ['PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'temporarily_held', 'PENDING']);

      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Player Updates
        (
          (request.resource.data.playerId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.pitchId == resource.data.pitchId &&
          request.resource.data.get('totalPrice', 0) == resource.data.get('totalPrice', 0) &&
          request.resource.data.get('totalAmount', 0) == resource.data.get('totalAmount', 0) &&
          !(request.resource.data.status in ['CONFIRMED', 'CHECKED_IN', 'COMPLETED']) &&
          (
            (request.resource.data.status == 'CANCELLED' && (resource.data.status in ['PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'temporarily_held', 'PENDING'])) ||
            (request.resource.data.status == 'PAYMENT_SUBMITTED' && (resource.data.status in ['PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'temporarily_held', 'PENDING'])) ||
            (request.resource.data.status == 'PENDING_PAYMENT' && (resource.data.status in ['PAYMENT_SUBMITTED', 'PENDING_PAYMENT', 'temporarily_held', 'PENDING'])) ||
            (request.resource.data.status == resource.data.status)
          )
        ) ||
        // Owner / Staff / Admin Updates
        (
          (resource.data.get('ownerId', '') == request.auth.uid || resource.data.get('ownerId', '') == '' || !('ownerId' in resource.data) || request.resource.data.status in ['CHECKED_IN', 'COMPLETED', 'CONFIRMED', 'CANCELLED', 'REJECTED'] || isAdmin()) &&
          (
             (request.resource.data.status in ['CONFIRMED', 'REJECTED', 'CANCELLED', 'CHECKED_IN', 'COMPLETED']) ||
             (request.resource.data.status == resource.data.status)
          )
        )
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.playerId == request.auth.uid || 
          resource.data.userId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid
        )
      );

      // MOTM VOTES & MATCH SUMMARIES
      match /motmVotes/{voteId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && 
                                voteId == request.auth.uid && 
                                isBookingParticipant(bookingId) && 
                                get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'COMPLETED';
        allow delete: if isAuthenticated() && voteId == request.auth.uid;
      }

      match /summary/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (isBookingParticipant(bookingId) || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // TEAMS
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.captainId == request.auth.uid || isAdmin());
    }

    // CONVERSATIONS
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && 
                    request.auth.uid in request.resource.data.participants &&
                    (
                      (request.resource.data.type == 'DIRECT' && request.resource.data.participants.size() == 2) ||
                      (request.resource.data.type == 'GROUP' || request.resource.data.type == 'TEAM')
                    );
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && 
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                      request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // MATCHES
    match /{path=**}/matchPlayers/{playerId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /matches/{matchId} {
      allow read: if resource == null || resource.data.visibility == 'Public';
      allow read: if isAuthenticated() && (
        resource.data.captainId == request.auth.uid || 
        exists(/databases/$(database)/documents/matches/$(matchId)/matchPlayers/$(request.auth.uid)) ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.captainId == request.auth.uid || isAdmin());
      
      match /matchPlayers/{playerId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.captainId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.captainId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.captainId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // PAYMENTS
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.payerId == request.auth.uid ||
        resource.data.payeeId == request.auth.uid ||
        isAdmin()
      );
      // Client shouldn't directly create successful payments unless it's a webhook or function
      allow write: if isAdmin(); 
    }
    
    // TRANSACTIONS
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // OWNERS
    match /owners/{ownerId} {
      allow read: if true;
      allow create: if isAuthenticated() && ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.playerId == request.auth.uid || isAdmin());
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // MATCH INVITATIONS (Proposed games before a slot is booked)
    match /matchInvitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.get('invitedUserIds', []) ||
        resource.data.get('broadcastToPreviousBookers', false) == true ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // REPORTS
    match /reports/{reportId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ADMIN REVIEWS
    match /adminReviews/{adminReviewId} {
      allow read, write: if isAdmin();
    }

    // DISPUTES
    match /disputes/{disputeId} {
      allow read, write: if isAdmin();
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Since admins create logs via client SDK
    }

    // PLATFORM SETTINGS
    match /platformSettings/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // SLOT SUBSCRIPTIONS & NOTIFICATIONS
    match /slotAlertSubscriptions/{subId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /slotNotifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // SLOT CANCELLATIONS (Option A)
    match /slotCancellations/{cancelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.pitchId is string
        && request.resource.data.date is string
        && request.resource.data.time is string;
    }

    // ==========================================
    // TOURNAMENT HUB (WEHAT & PUBLIC TOURNAMENTS)
    // ==========================================
    match /tournamentFixtures/{fixtureId} {
      allow read, write: if true;
    }

    match /tournamentScorers/{scorerId} {
      allow read, write: if true;
    }

    match /tournamentNominees/{nomineeId} {
      allow read, write: if true;
    }
  }
}
