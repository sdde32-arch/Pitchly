rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS & ROLE DEFINITIONS
    // ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'qC5nIOnLw3TdGko6OdStE7OvDBG3' ||
        request.auth.token.get('role', '') in ['admin', 'super_admin', 'ADMIN'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'ADMIN', 'super_admin', 'SUPER_ADMIN'])
      );
    }

    function isSuperAdmin() {
      let isAuthenticatedUser = request.auth != null;
      let uid = isAuthenticatedUser ? request.auth.uid : 'none';
      let userDoc = isAuthenticatedUser && exists(/databases/$(database)/documents/users/$(uid)) ? get(/databases/$(database)/documents/users/$(uid)) : null;
      return isAuthenticatedUser && (
        request.auth.uid == 'qC5nIOnLw3TdGko6OdStE7OvDBG3' ||
        request.auth.token.get('role', '') in ['super_admin', 'SUPER_ADMIN'] || 
        (userDoc != null && userDoc.data.get('role', '') in ['super_admin', 'SUPER_ADMIN'])
      );
    }

    function isOwnerRole() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') in ['OWNER', 'owner'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['OWNER', 'owner'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['OWNER', 'owner'])
        ))
      );
    }

    function isOrganizer() {
      return isAdmin() || (isAuthenticated() && (
        request.auth.token.get('role', '') in ['ORGANIZER', 'organizer'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['ORGANIZER', 'organizer'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['ORGANIZER', 'organizer'])
        ))
      ));
    }

    // Role enum validation
    function isValidUserRole(role) {
      return role in ['PLAYER', 'OWNER', 'player', 'owner', 'staff', 'STAFF', 'ADMIN', 'admin', 'super_admin', 'CARETAKER', 'caretaker'];
    }

    // Strict PitchStatus enum validation
    function isValidPitchStatus(status) {
      return status in [
        'ACTIVE',
        'MAINTENANCE',
        'CLOSED',
        'PENDING_APPROVAL',
        'PENDING_INSPECTION',
        'REJECTED',
        'changes_requested',
        'pending_review',
        'pending_inspection'
      ];
    }

    // Strict BookingStatus enum validation
    function isValidBookingStatus(status) {
      return status in [
        'PENDING_PAYMENT',
        'PAYMENT_SUBMITTED',
        'CONFIRMED',
        'DEPOSIT_PAID',
        'TENTATIVE',
        'PREEMPTED',
        'REJECTED',
        'CANCELLED',
        'COMPLETED',
        'DISPUTED',
        'CHECKED_IN',
        'NO_SHOW',
        'PENDING',
        'temporarily_held'
      ];
    }

    // Strict PaymentMethod enum validation
    function isValidPaymentMethod(method) {
      return method == null || method in [
        'CASH',
        'MTN',
        'AIRTEL',
        'MOBILE_MONEY',
        'CARD',
        'cash',
        'mtn',
        'airtel',
        'mobile_money',
        'card'
      ];
    }

    function isBookingParticipant(bId) {
      let bPath = /databases/$(database)/documents/bookings/$(bId);
      return exists(bPath) && (
        get(bPath).data.playerId == request.auth.uid || 
        get(bPath).data.userId == request.auth.uid || 
        get(bPath).data.ownerId == request.auth.uid
      );
    }

    function hasPaymentProof(d) {
      return (d.get('transactionRef', '') is string && d.get('transactionRef', '').size() >= 6) ||
             (d.get('paymentProofUrl', '') is string && d.get('paymentProofUrl', '').size() > 10);
    }

    function isValidPreemptingPayer(resourceData, requestResourceData) {
      let payer = getAfter(/databases/$(database)/documents/bookings/$(requestResourceData.preemptedByBookingId)).data;
      return payer.get('userId', '') == request.auth.uid &&
             payer.get('status', '') == 'PAYMENT_SUBMITTED' &&
             hasPaymentProof(payer) &&
             payer.get('bookingTier', '') in ['DEPOSIT', 'FULL'] &&
             payer.get('pitchId', '') == resourceData.get('pitchId', '') &&
             payer.get('date', '') == resourceData.get('date', '') &&
             payer.get('slots', []).hasAny(resourceData.get('slots', []));
    }

    // ─────────────────────────────────────────────────────────────
    // USERS COLLECTION
    // Strictly restricts self-promotion to ADMIN/super_admin/OWNER escalation
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // On creation: Normal signups can ONLY be PLAYER (or OWNER if registering via owner toggle)
      // Strictly BLOCKS self-assigning ADMIN or super_admin or writing privileged fields
      allow create: if isAuthenticated() 
        && userId == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role in ['PLAYER', 'OWNER'])
        && (!request.resource.data.keys().hasAll(['roles']) || 
            (request.resource.data.roles.hasOnly(['PLAYER', 'OWNER']) && !request.resource.data.roles.hasAny(['ADMIN', 'admin', 'super_admin'])))
        && !request.resource.data.keys().hasAny(['isAdmin', 'isSuperAdmin', 'permissions']);
      
      // On update: Doc owner may update their own profile; can never elevate to admin;
      // may change roles only to a list containing "PLAYER" and whose elements are only "PLAYER" or "OWNER";
      // may change role only to "PLAYER" or "OWNER" matching the resulting roles list;
      // supports legacy docs without id or role fields; isAdmin() keeps full update.
      allow update: if (
        isOwner(userId) &&
        // Cannot change administrative privilege flags
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isSuperAdmin', 'permissions']) &&
        // Check id only if it exists on legacy doc
        (!resource.data.keys().hasAll(['id']) || request.resource.data.id == resource.data.id) &&
        // Roles array may only be changed to a list that contains "PLAYER" and whose elements are only "PLAYER" or "OWNER"
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles']) ||
          (
            request.resource.data.roles is list &&
            request.resource.data.roles.hasAll(['PLAYER']) &&
            request.resource.data.roles.hasOnly(['PLAYER', 'OWNER'])
          )
        ) &&
        // Role may change only to "PLAYER" or "OWNER", and the new role must be in the resulting roles list
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          (
            request.resource.data.role in ['PLAYER', 'OWNER'] &&
            request.resource.data.role in request.resource.data.get('roles', resource.data.get('roles', ['PLAYER']))
          )
        )
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasOnly(['id','name','avatar','avatarId','updatedAt'])
        && request.resource.data.get('name','') is string
        && request.resource.data.name.size() <= 100;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /tournaments/{tournamentId} {
      function validTournamentContent(d) {
        return d.name is string && d.name.size() >= 3 && d.name.size() <= 100
          && d.organizerName is string && d.organizerName.size() <= 100
          && d.venueText is string && d.venueText.size() >= 1 && d.venueText.size() <= 200
          && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.format in ['knockout', 'league', 'groups_knockout', 'other']
          && (!d.keys().hasAny(['description']) || (d.description is string && d.description.size() <= 2000))
          && (!d.keys().hasAny(['bannerUrl']) || (d.bannerUrl is string && d.bannerUrl.size() <= 500 && d.bannerUrl.matches('^https://.*')))
          && (!d.keys().hasAny(['endDate']) || (d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!d.keys().hasAny(['pitchId']) || (d.pitchId is string && d.pitchId.size() <= 100))
          && (!d.keys().hasAny(['season']) || (d.season is string && d.season.size() <= 50))
          && (!d.keys().hasAny(['week']) || (d.week is string && d.week.size() <= 50))
          && (!d.keys().hasAny(['phase']) || d.phase in ['scheduled', 'live', 'postponed', 'completed', 'cancelled'])
          && (!d.keys().hasAny(['scheduleNote']) || (d.scheduleNote is string && d.scheduleNote.size() <= 300))
          && (!d.keys().hasAny(['championName']) || (d.championName is string && d.championName.size() <= 100))
          && (!d.keys().hasAny(['runnerUpName']) || (d.runnerUpName is string && d.runnerUpName.size() <= 100))
          && (!d.keys().hasAny(['completedAt']) || d.completedAt is timestamp);
      }

      // Public sees approved. Organizer sees their own (any status). Admin sees all.
      allow read: if resource.data.status == 'approved'
        || (isAuthenticated() && resource.data.organizerId == request.auth.uid)
        || isAdmin();

      // Anyone signed in may submit a PENDING tournament that they own. Phase, if sent, must be 'scheduled'.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['id', 'name', 'description', 'bannerUrl', 'organizerId', 'organizerName', 'startDate', 'endDate', 'format', 'venueText', 'pitchId', 'status', 'createdAt', 'updatedAt', 'season', 'week', 'phase', 'scheduleNote'])
        && request.resource.data.keys().hasAll(['id', 'name', 'organizerId', 'organizerName', 'startDate', 'format', 'venueText', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.id == tournamentId
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAny(['phase']) || request.resource.data.phase == 'scheduled')
        && validTournamentContent(request.resource.data);

      // Admin may change anything (approve, reject, take down, reopen, correct after the lock).
      // Organizer may edit ONLY descriptive and lifecycle fields of their own tournament, never status or ownership.
      // Once completed, the organizer can edit for 2 days after completedAt, then only an admin can.
      allow update: if isAdmin()
        || (isAuthenticated()
            && resource.data.organizerId == request.auth.uid
            && request.resource.data.organizerId == resource.data.organizerId
            && request.resource.data.id == resource.data.id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'bannerUrl', 'startDate', 'endDate', 'format', 'venueText', 'pitchId', 'season', 'week', 'phase', 'scheduleNote', 'championName', 'runnerUpName', 'completedAt', 'updatedAt'])
            && validTournamentContent(request.resource.data)
            && request.time < resource.data.get('completedAt', request.time) + duration.value(2, 'd')
            && (resource.data.get('phase', 'scheduled') != 'completed' || request.resource.data.get('phase', 'scheduled') == 'completed')
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedAt'])
                || (request.resource.data.get('phase', 'scheduled') == 'completed' && request.resource.data.completedAt == request.time))
            && (request.resource.data.get('phase', 'scheduled') != 'completed' || request.resource.data.keys().hasAny(['completedAt'])));

      // Admin may delete anything. Organizer may delete only their own pending or rejected tournament.
      allow delete: if isAdmin()
        || (isAuthenticated()
            && resource.data.organizerId == request.auth.uid
            && resource.data.status in ['pending', 'rejected']);
    }

    // ─────────────────────────────────────────────────────────────
    // PITCHES COLLECTION
    // Enforces PitchStatus, validates owner ownership, restricts unverified writes
    // ─────────────────────────────────────────────────────────────
    match /pitches/{pitchId} {
      // Public read so players & visitors can discover pitches
      allow read: if true;

      // Owners can create their own pitches; status must start as PENDING_APPROVAL / PENDING_INSPECTION
      // Strict PitchStatus enforcement: nobody can create an already-approved pitch except Admin
      allow create: if isAuthenticated() &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        request.resource.data.get('status', '') in ['PENDING_APPROVAL', 'PENDING_INSPECTION', 'pending_review'] &&
        isValidPitchStatus(request.resource.data.status) &&
        (isOwnerRole() || isAdmin());

      // Pitch updates:
      // 1. Authenticated players can update review aggregate ratings (stopgap measure: not proof of real review)
      // 2. Platform Admins can update all fields with valid status
      // 3. Pitch Owners can update their own pitch without changing ownerId, aggregates, or admin-controlled fields
      allow update: if isAuthenticated() && (
        // Allow review aggregate updates from players (stopgap measure: not proof of real review)
        (
          resource.data.get('status', '') == 'ACTIVE' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount', 'updatedAt']) &&
          request.resource.data.get('rating', 0) is number &&
          request.resource.data.get('rating', 0) >= 0 &&
          request.resource.data.get('rating', 0) <= 5 &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewCount']) ||
           (request.resource.data.get('reviewCount', 0) is int && request.resource.data.get('reviewCount', 0) >= 0))
        ) ||
        // Admin update
        (isAdmin() && isValidPitchStatus(request.resource.data.get('status', resource.data.status))) ||
        // Owner update: cannot tamper with rating/review aggregates or admin-moderated fields
        (
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'rating', 'reviewCount', 'isVerified', 'featured', 'isFeatured', 'commission', 'commissionRate',
            'approvalStage', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'rejectionReason',
            'reviewedAt', 'reviewedBy', 'changeRequestMessage', 'adminFeedback', 'inspectedAt', 'inspectedBy', 'certificationNumber'
          ]) &&
          isValidPitchStatus(request.resource.data.get('status', resource.data.status)) &&
          (
            request.resource.data.status == resource.data.status ||
            request.resource.data.status in ['PENDING_APPROVAL', 'PENDING_INSPECTION', 'MAINTENANCE', 'CLOSED'] ||
            (resource.data.status == 'ACTIVE' && request.resource.data.status == 'ACTIVE')
          )
        )
      );

      // Only Pitch Owner or Platform Admin can delete
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────────
    // SLOT LOCKS
    // Atomic concurrency locks for real-time checkout & preemption
    // ─────────────────────────────────────────────────────────────
    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        isAdmin() || 
        request.resource.data.status in ['expired', 'released', 'preempted'] ||
        resource.data.status == 'tentative' ||
        resource.data.get('tier', '') == 'TENTATIVE'
      );
      allow delete: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.status in ['expired', 'released', 'preempted'] ||
        resource.data.status == 'tentative'
      ));
    }

    // ─────────────────────────────────────────────────────────────
    // SLOT AVAILABILITY (Public lightweight mirror without PII)
    // ─────────────────────────────────────────────────────────────
    match /slotAvailability/{slotId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // STAFF
    // Pitch staff / caretaker invitations & ground check-in rights
    // ─────────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        resource.data.status == 'PENDING' ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        (
          resource.data.status == 'PENDING' && 
          request.resource.data.userId == request.auth.uid && 
          request.resource.data.status == 'ACTIVE'
        ) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // BOOKINGS COLLECTION
    // Enforces BookingStatus, PaymentMethod, price tampering prevention,
    // and limits read/write strictly to authorized participants & admin
    // ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Read access restricted strictly to: booking player, pitch owner, or platform admin
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.playerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      
      // Create: Enforce player identity, valid BookingStatus, and valid PaymentMethod
      // Must target an ACTIVE pitch, and ownerId on the booking must match pitch.ownerId
      allow create: if isAuthenticated() && 
        (request.resource.data.playerId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        isValidBookingStatus(request.resource.data.status) &&
        isValidPaymentMethod(request.resource.data.get('paymentMethod', null)) &&
        (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/pitches/$(request.resource.data.get('pitchId', request.resource.data.get('turfId', '')))) &&
            get(/databases/$(database)/documents/pitches/$(request.resource.data.get('pitchId', request.resource.data.get('turfId', '')))).data.ownerId == request.resource.data.ownerId &&
            get(/databases/$(database)/documents/pitches/$(request.resource.data.get('pitchId', request.resource.data.get('turfId', '')))).data.get('status', '') in ['ACTIVE', 'active', 'approved', 'APPROVED'] &&
            (
              // (a) UNPAID HOLD
              (
                request.resource.data.status == 'TENTATIVE' &&
                request.resource.data.get('bookingTier', '') == 'TENTATIVE' &&
                request.resource.data.get('paymentMethod', '') in ['CASH', 'cash'] &&
                request.resource.data.get('depositAmount', 0) == 0 &&
                request.resource.data.get('paymentStatus', '') == 'UNPAID' &&
                get(/databases/$(database)/documents/pitches/$(request.resource.data.get('pitchId', request.resource.data.get('turfId', '')))).data.get('allowUnpaidReservations', true) == true
              ) ||
              // (b) PAID
              (
                request.resource.data.status in ['PENDING_PAYMENT', 'PAYMENT_SUBMITTED'] &&
                request.resource.data.get('bookingTier', '') in ['DEPOSIT', 'FULL'] &&
                !(request.resource.data.get('paymentMethod', '') in ['CASH', 'cash']) &&
                (request.resource.data.status != 'PAYMENT_SUBMITTED' || hasPaymentProof(request.resource.data))
              )
            )
          )
        );

      // Update: Strict authorization per participant role
      allow update: if isAuthenticated() && 
        isValidBookingStatus(request.resource.data.status) &&
        isValidPaymentMethod(request.resource.data.get('paymentMethod', null)) &&
        (
          // Preemption of tentative bookings by paying players: strictly restricted to preemption fields only
          (
            resource.data.status == 'TENTATIVE' &&
            request.resource.data.status == 'PREEMPTED' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'preemptedAt', 'preemptedByBookingId', 'cancellationReason', 'updatedAt'
            ]) &&
            request.resource.data.get('preemptedByBookingId', '') != '' &&
            isValidPreemptingPayer(resource.data, request.resource.data)
          ) ||
          // Player Updates: Can submit receipt, upgrade tier, or cancel their unconfirmed booking.
          // Absolutely CANNOT tamper with price, ownerId, pitchId, or self-confirm!
          (
            (resource.data.playerId == request.auth.uid || resource.data.userId == request.auth.uid) &&
            request.resource.data.playerId == resource.data.playerId &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.pitchId == resource.data.pitchId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'bookingTier', 'paymentStatus', 'paymentMethod',
              'paymentProofUrl', 'virtualReceiptUrl', 'transactionRef',
              'depositAmount', 'balanceDue', 'paymentSubmittedAt', 'updatedAt',
              'cancellationReason', 'cancelledAt', 'holdExpiresAt'
            ]) &&
            // bookingTier may change only when existing booking status is TENTATIVE
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bookingTier']) ||
             request.resource.data.bookingTier == resource.data.bookingTier ||
             resource.data.status == 'TENTATIVE') &&
            // holdExpiresAt may change only during TENTATIVE upgrade
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['holdExpiresAt']) ||
             request.resource.data.holdExpiresAt == resource.data.holdExpiresAt ||
             resource.data.status == 'TENTATIVE') &&
            // paymentStatus may never be set to PAID by players (only SUBMITTED, PARTIAL, or unchanged)
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) ||
             request.resource.data.paymentStatus == resource.data.paymentStatus ||
             request.resource.data.paymentStatus in ['SUBMITTED', 'PARTIAL']) &&
            // Price is strictly immutable
            request.resource.data.get('totalPrice', 0) == resource.data.get('totalPrice', 0) &&
            request.resource.data.get('price', 0) == resource.data.get('price', 0) &&
            // Deposit amount & balance due validation
            (
              (request.resource.data.get('depositAmount', 0) == resource.data.get('depositAmount', 0) &&
               request.resource.data.get('balanceDue', 0) == resource.data.get('balanceDue', 0)) ||
              (
                resource.data.status == 'TENTATIVE' && (
                  (request.resource.data.bookingTier == 'DEPOSIT' &&
                   request.resource.data.get('depositAmount', 0) > 0 &&
                   request.resource.data.get('depositAmount', 0) + request.resource.data.get('balanceDue', 0) == resource.data.get('totalPrice', resource.data.get('price', 0))) ||
                  (request.resource.data.bookingTier == 'FULL' &&
                   request.resource.data.get('depositAmount', 0) == 0 &&
                   request.resource.data.get('balanceDue', 0) == 0)
                )
              )
            ) &&
            !(request.resource.data.status in ['CONFIRMED', 'CHECKED_IN', 'COMPLETED', 'DEPOSIT_PAID']) &&
            (request.resource.data.status != 'PAYMENT_SUBMITTED' || hasPaymentProof(request.resource.data)) &&
            (
              (request.resource.data.status == 'CANCELLED' && (resource.data.status in ['PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'temporarily_held', 'PENDING', 'TENTATIVE'])) ||
              (request.resource.data.status in ['PAYMENT_SUBMITTED', 'PENDING_PAYMENT'] && (resource.data.status in ['PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'temporarily_held', 'PENDING', 'TENTATIVE'])) ||
              (request.resource.data.status == resource.data.status)
            )
          ) ||
          // Owner Updates: Can confirm receipts, check in players, or reject bookings for their own pitch
          (
            resource.data.ownerId == request.auth.uid &&
            request.resource.data.ownerId == resource.data.ownerId &&
            request.resource.data.pitchId == resource.data.pitchId &&
            (
              request.resource.data.status in ['CONFIRMED', 'REJECTED', 'CANCELLED', 'CHECKED_IN', 'COMPLETED', 'DEPOSIT_PAID', 'DISPUTED'] ||
              request.resource.data.status == resource.data.status
            )
          ) ||
          isAdmin()
        );

      // Delete: Restricted to participants or admin, and only for unconfirmed/cancelled/rejected statuses
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.playerId == request.auth.uid || 
          resource.data.userId == request.auth.uid || 
          resource.data.ownerId == request.auth.uid
        ) && (
          resource.data.status in [
            'PENDING_PAYMENT',
            'TENTATIVE',
            'PENDING',
            'temporarily_held',
            'PREEMPTED',
            'CANCELLED',
            'REJECTED'
          ]
        )
      );

      // MOTM VOTES & MATCH SUMMARIES SUBCOLLECTIONS
      match /motmVotes/{voteId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && 
                                voteId == request.auth.uid && 
                                isBookingParticipant(bookingId) && 
                                get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'COMPLETED';
        allow delete: if isAuthenticated() && voteId == request.auth.uid;
      }

      match /summary/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (isBookingParticipant(bookingId) || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // TEAMS & SQUADS
    // ─────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.captainId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.captainId == request.auth.uid ||
        request.auth.uid in resource.data.get('memberIds', []) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.captainId == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // CONVERSATIONS & MESSAGES
    // ─────────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && 
                    request.auth.uid in request.resource.data.participants &&
                    (
                      (request.resource.data.type == 'DIRECT' && request.resource.data.participants.size() == 2) ||
                      (request.resource.data.type == 'GROUP' || request.resource.data.type == 'TEAM')
                    );
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() && 
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                      request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // MATCHES & LINEUPS
    // ─────────────────────────────────────────────────────────────
    match /{path=**}/matchPlayers/{playerId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /matches/{matchId} {
      allow read: if resource == null || resource.data.visibility == 'Public';
      allow read: if isAuthenticated() && (
        resource.data.captainId == request.auth.uid || 
        exists(/databases/$(database)/documents/matches/$(matchId)/matchPlayers/$(request.auth.uid)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.captainId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.captainId == request.auth.uid || isAdmin());
      
      match /matchPlayers/{playerId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.captainId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.captainId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.captainId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ─────────────────────────────────────────────────────────────
    // PAYMENTS & FINANCIAL TRANSACTIONS
    // ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.payerId == request.auth.uid ||
        resource.data.payeeId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin(); 
    }
    
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // OWNERS BUSINESS PROFILES
    // ─────────────────────────────────────────────────────────────
    match /owners/{ownerId} {
      allow read: if true;
      allow create: if isAuthenticated() && ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // REVIEWS
    // ─────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.playerId == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // MATCH INVITATIONS
    // ─────────────────────────────────────────────────────────────
    match /matchInvitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.get('invitedUserIds', []) ||
        resource.data.get('broadcastToPreviousBookers', false) == true ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // ADMINISTRATIVE LOGS, REPORTS & SETTINGS
    // ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
    }

    match /adminReviews/{adminReviewId} {
      allow read, write: if isAdmin();
    }

    match /bookingAdminNotes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /platformSettings/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // SLOT SUBSCRIPTIONS & ALERTS
    // ─────────────────────────────────────────────────────────────
    match /slotAlertSubscriptions/{subId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /slotNotifications/{notifId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /slotCancellations/{cancelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.pitchId is string
        && request.resource.data.date is string
        && request.resource.data.time is string;
    }

    // ─────────────────────────────────────────────────────────────
    // TOURNAMENT HUB & PUBLIC TOURNAMENTS
    // ─────────────────────────────────────────────────────────────
    function tournamentPath(tid) {
      return /databases/$(database)/documents/tournaments/$(tid);
    }

    // True when the signed-in user created this tournament, it is pending or approved,
    // and the 2-day window after completion has not passed.
    function ownsOpenTournament(tid) {
      let t = get(tournamentPath(tid)).data;
      return isAuthenticated()
        && t.organizerId == request.auth.uid
        && t.status in ['pending', 'approved']
        && request.time < t.get('completedAt', request.time) + duration.value(2, 'd');
    }

    // Voting stays open unless the tournament document says it is completed.
    function tournamentVotingOpen(tid) {
      return !exists(tournamentPath(tid))
        || get(tournamentPath(tid)).data.get('phase', 'scheduled') != 'completed';
    }

    match /tournamentFixtures/{fixtureId} {
      allow read: if true;
      allow create: if isAdmin() || ownsOpenTournament(request.resource.data.tournamentId);
      allow update: if isAdmin()
        || (resource.data.tournamentId == request.resource.data.tournamentId
            && ownsOpenTournament(resource.data.tournamentId));
      allow delete: if isAdmin() || ownsOpenTournament(resource.data.tournamentId);
    }

    match /tournamentScorers/{scorerId} {
      allow read: if true;
      allow create: if isAdmin() || ownsOpenTournament(request.resource.data.tournamentId);
      allow update: if isAdmin()
        || (resource.data.tournamentId == request.resource.data.tournamentId
            && ownsOpenTournament(resource.data.tournamentId));
      allow delete: if isAdmin() || ownsOpenTournament(resource.data.tournamentId);
    }

    match /tournamentNominees/{nomineeId} {
      allow read: if true;
      allow create: if isAdmin() || ownsOpenTournament(request.resource.data.tournamentId);
      // Voters may add exactly +1 to voteCount while voting is open. Admin and the tournament creator may change anything.
      allow update: if (isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount', 'updatedAt'])
          && request.resource.data.get('voteCount', 0) == resource.data.get('voteCount', 0) + 1
          && tournamentVotingOpen(resource.data.tournamentId))
        || isAdmin()
        || (resource.data.tournamentId == request.resource.data.tournamentId
            && ownsOpenTournament(resource.data.tournamentId));
      allow delete: if isAdmin() || ownsOpenTournament(resource.data.tournamentId);
    }

    match /tournamentTeams/{teamId} {
      allow read: if true;
      allow create: if isAdmin() || ownsOpenTournament(request.resource.data.tournamentId);
      allow update: if isAdmin()
        || (resource.data.tournamentId == request.resource.data.tournamentId
            && ownsOpenTournament(resource.data.tournamentId));
      allow delete: if isAdmin() || ownsOpenTournament(resource.data.tournamentId);
    }

    match /tournamentPlayers/{playerId} {
      allow read: if true;
      allow create: if isAdmin() || ownsOpenTournament(request.resource.data.tournamentId);
      allow update: if isAdmin()
        || (resource.data.tournamentId == request.resource.data.tournamentId
            && ownsOpenTournament(resource.data.tournamentId));
      allow delete: if isAdmin() || ownsOpenTournament(resource.data.tournamentId);
    }

    match /tournamentStandings/{standingId} {
      allow read: if true;
      allow create: if isAdmin() || ownsOpenTournament(request.resource.data.tournamentId);
      allow update: if isAdmin()
        || (resource.data.tournamentId == request.resource.data.tournamentId
            && ownsOpenTournament(resource.data.tournamentId));
      allow delete: if isAdmin() || ownsOpenTournament(resource.data.tournamentId);
    }

    // ─────────────────────────────────────────────────────────────
    // TOURNAMENT CONTACTS (PRIVATE STORAGE)
    // Secure private contact numbers for team managers and players.
    // Never publicly readable or writable.
    // ─────────────────────────────────────────────────────────────
    function isTournamentOrganizer(tid) {
      let tPath = tournamentPath(tid);
      return isAuthenticated()
        && exists(tPath)
        && ownsOpenTournament(tid);
    }

    function targetTeamBelongsToTournament(teamId, tid) {
      let tPath = /databases/$(database)/documents/tournamentTeams/$(teamId);
      return (exists(tPath) && get(tPath).data.tournamentId == tid)
        || (existsAfter(tPath) && getAfter(tPath).data.tournamentId == tid);
    }

    function targetPlayerBelongsToTournament(playerId, tid) {
      let pPath = /databases/$(database)/documents/tournamentPlayers/$(playerId);
      return (exists(pPath) && get(pPath).data.tournamentId == tid)
        || (existsAfter(pPath) && getAfter(pPath).data.tournamentId == tid);
    }

    function isValidTournamentContactData(d, contactId) {
      return d.id == contactId
        && d.tournamentId is string && d.tournamentId.size() > 0 && d.tournamentId.size() <= 100
        && exists(tournamentPath(d.tournamentId))
        && d.contactNumber is string && d.contactNumber.size() >= 5 && d.contactNumber.size() <= 30
        && d.contactNumber.matches('^\\+?[0-9\\s\\-\\(\\)]{5,30}$')
        && (!d.keys().hasAny(['updatedAt']) || (d.updatedAt is string && d.updatedAt.size() <= 50))
        && (!d.keys().hasAny(['createdAt']) || (d.createdAt is string && d.createdAt.size() <= 50))
        && d.targetId is string
        && (
          (d.type == 'team'
            && d.keys().hasOnly(['id', 'tournamentId', 'type', 'targetId', 'teamId', 'contactNumber', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['id', 'tournamentId', 'type', 'targetId', 'teamId', 'contactNumber'])
            && d.targetId is string
            && d.teamId is string
            && d.targetId == d.teamId
            && contactId == 'tc_team_' + d.teamId
            && targetTeamBelongsToTournament(d.teamId, d.tournamentId))
          ||
          (d.type == 'player'
            && d.keys().hasOnly(['id', 'tournamentId', 'type', 'targetId', 'playerId', 'contactNumber', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['id', 'tournamentId', 'type', 'targetId', 'playerId', 'contactNumber'])
            && d.targetId is string
            && d.playerId is string
            && d.targetId == d.playerId
            && contactId == 'tc_player_' + d.playerId
            && targetPlayerBelongsToTournament(d.playerId, d.tournamentId))
        );
    }

    match /tournamentContacts/{contactId} {
      // Private reads: ONLY admins or authorized tournament owner
      allow read: if isAdmin() || isTournamentOrganizer(resource.data.tournamentId);

      // Create: Only admin or open tournament owner, with full validation
      allow create: if (isAdmin() || isTournamentOrganizer(request.resource.data.tournamentId))
        && isValidTournamentContactData(request.resource.data, contactId);

      // Update: Only admin or open tournament owner; immutable tournamentId, type, targetId, teamId/playerId, id, createdAt
      allow update: if (isAdmin() || isTournamentOrganizer(resource.data.tournamentId))
        && request.resource.data.id == resource.data.id
        && request.resource.data.tournamentId == resource.data.tournamentId
        && request.resource.data.type == resource.data.type
        && request.resource.data.targetId == resource.data.targetId
        && (!resource.data.keys().hasAny(['teamId']) || request.resource.data.teamId == resource.data.teamId)
        && (!resource.data.keys().hasAny(['playerId']) || request.resource.data.playerId == resource.data.playerId)
        && (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactNumber', 'updatedAt'])
        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.size() >= 5
        && request.resource.data.contactNumber.size() <= 30
        && request.resource.data.contactNumber.matches('^\\+?[0-9\\s\\-\\(\\)]{5,30}$')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 50));

      // Delete: Only admin or open tournament owner
      allow delete: if isAdmin() || isTournamentOrganizer(resource.data.tournamentId);
    }

    // ─────────────────────────────────────────────────────────────
    // COMMUNITY ACTIVITY FEED
    // ─────────────────────────────────────────────────────────────
    match /communityActivities/{activityId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Allow liking/celebrating reactions atomically
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'celebrationsCount', 'likedBy', 'celebratedBy']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
